{"captainVersion":4,"services":{"$$cap_appname":{"image":"vexaai/vexa-dashboard:$$cap_vexa_dashboard_tag","depends_on":["$$cap_appname-api"],"restart":"unless-stopped","environment":{"VEXA_API_URL":"http://srv-captain--$$cap_appname-api:8056","VEXA_ADMIN_API_URL":"http://srv-captain--$$cap_appname-api:8056","VEXA_ADMIN_API_KEY":"$$cap_admin_api_token","NEXT_PUBLIC_VEXA_WS_URL":"wss://$$cap_appname-api.$$cap_root_domain/ws","NEXT_PUBLIC_APP_URL":"https://$$cap_appname.$$cap_root_domain","NEXT_PUBLIC_BASE_URL":"https://$$cap_appname.$$cap_root_domain","NEXT_PUBLIC_TRANSCRIPT_SHARE_BASE_URL":"https://$$cap_appname-api.$$cap_root_domain","NEXTAUTH_URL":"https://$$cap_appname.$$cap_root_domain","NEXTAUTH_SECRET":"$$cap_nextauth_secret","JWT_SECRET":"$$cap_jwt_secret","ALLOW_REGISTRATIONS":"$$cap_allow_registrations","ALLOWED_EMAIL_DOMAINS":"$$cap_allowed_email_domains","DEFAULT_BOT_NAME":"$$cap_default_bot_name"},"caproverExtra":{"containerHttpPort":3000}},"$$cap_appname-api":{"image":"vexaai/vexa-lite:$$cap_vexa_lite_tag","depends_on":["$$cap_appname-db"],"volumes":["$$cap_appname-api-recordings:/var/lib/vexa/recordings","$$cap_appname-api-redis:/var/lib/redis","$$cap_appname-api-shm:/dev/shm"],"restart":"unless-stopped","environment":{"DATABASE_URL":"postgresql://$$cap_postgres_user:$$cap_postgres_password@srv-captain--$$cap_appname-db:5432/$$cap_postgres_db","DB_SSL_MODE":"disable","ADMIN_API_TOKEN":"$$cap_admin_api_token","TRANSCRIPTION_SERVICE_URL":"$$cap_transcription_service_url","TRANSCRIPTION_SERVICE_TOKEN":"$$cap_transcription_service_token","OPENAI_API_KEY":"$$cap_openai_api_key","SKIP_TRANSCRIPTION_CHECK":"$$cap_skip_transcription_check","LOG_LEVEL":"$$cap_log_level","STORAGE_BACKEND":"local","LOCAL_STORAGE_DIR":"/var/lib/vexa/recordings","CORS_ORIGINS":"https://$$cap_appname.$$cap_root_domain","PUBLIC_BASE_URL":"https://$$cap_appname-api.$$cap_root_domain"},"caproverExtra":{"containerHttpPort":8056,"websocketSupport":"true"}},"$$cap_appname-db":{"image":"postgres:$$cap_postgres_version","volumes":["$$cap_appname-db-data:/var/lib/postgresql"],"restart":"unless-stopped","environment":{"POSTGRES_DB":"$$cap_postgres_db","POSTGRES_USER":"$$cap_postgres_user","POSTGRES_PASSWORD":"$$cap_postgres_password"},"caproverExtra":{"notExposeAsWebApp":true}}},"caproverOneClickApp":{"variables":[{"id":"$$cap_vexa_lite_tag","label":"Vexa Lite Image Tag","description":"Docker tag for vexaai/vexa-lite. Use an immutable tag for production, or latest to follow upstream releases.","defaultValue":"latest","validRegex":"/.{1,}/"},{"id":"$$cap_vexa_dashboard_tag","label":"Vexa Dashboard Image Tag","description":"Docker tag for vexaai/vexa-dashboard. Use an immutable tag for production, or latest to follow upstream releases.","defaultValue":"latest","validRegex":"/.{1,}/"},{"id":"$$cap_postgres_version","label":"PostgreSQL Version","description":"Docker tag for the postgres image. PostgreSQL 18+ stores data under /var/lib/postgresql/<major>/docker, so this template mounts /var/lib/postgresql.","defaultValue":"18-alpine","validRegex":"/.{1,}/"},{"id":"$$cap_postgres_db","label":"PostgreSQL Database","defaultValue":"vexa","validRegex":"/.{1,}/"},{"id":"$$cap_postgres_user","label":"PostgreSQL User","defaultValue":"vexa","validRegex":"/.{1,}/"},{"id":"$$cap_postgres_password","label":"PostgreSQL Password","defaultValue":"$$cap_gen_random_hex(32)","validRegex":"/.{12,}/"},{"id":"$$cap_admin_api_token","label":"Vexa Admin API Token","description":"Save this value. It is required for dashboard admin access and user/token management.","defaultValue":"$$cap_gen_random_hex(64)","validRegex":"/.{32,}/"},{"id":"$$cap_transcription_service_url","label":"Vexa-Compatible Transcription Service URL","description":"Required. Use a self-hosted Vexa transcription service or an adapter exposing Vexa's OpenAI Whisper-compatible /v1/audio/transcriptions contract.","validRegex":"/^https?:\\/\\/.+/"},{"id":"$$cap_transcription_service_token","label":"Transcription Service Token","description":"Bearer token for the transcription service. Leave empty only if your compatible service is unauthenticated.","defaultValue":""},{"id":"$$cap_openai_api_key","label":"OpenAI API Key","description":"Optional. Required only for Vexa interactive TTS features.","defaultValue":""},{"id":"$$cap_skip_transcription_check","label":"Skip Startup Transcription Check","description":"Set to true only if the transcription endpoint cannot be reached during container startup.","defaultValue":"false","validRegex":"/^(true|false)$/"},{"id":"$$cap_log_level","label":"Log Level","defaultValue":"info","validRegex":"/^(debug|info|warning|error)$/"},{"id":"$$cap_allow_registrations","label":"Allow Dashboard Registrations","description":"Set to false for a private instance. Existing users can still log in.","defaultValue":"false","validRegex":"/^(true|false)$/"},{"id":"$$cap_allowed_email_domains","label":"Allowed Email Domains","description":"Optional comma-separated domain allowlist for dashboard registrations, such as medsgo.ph,example.com.","defaultValue":""},{"id":"$$cap_default_bot_name","label":"Default Bot Name","defaultValue":"Vexa - Open Source Bot"},{"id":"$$cap_nextauth_secret","label":"Dashboard NextAuth Secret","defaultValue":"$$cap_gen_random_hex(64)","validRegex":"/.{32,}/"},{"id":"$$cap_jwt_secret","label":"Dashboard JWT Secret","defaultValue":"$$cap_gen_random_hex(64)","validRegex":"/.{32,}/"}],"instructions":{"start":"Vexa Lite deploys the Vexa API gateway, bot runtime, internal Redis, and supporting services in one container.\nThis one-click app also deploys the standalone Vexa Dashboard and an internal PostgreSQL database.\n\nYou must provide a Vexa-compatible transcription endpoint. To avoid the Vexa-hosted API, self-host Vexa's transcription service or run an adapter that accepts Vexa's OpenAI Whisper-compatible multipart requests and returns text plus timestamped segments.\n\nDirect OpenAI, Google Cloud Speech-to-Text, or OpenRouter transcription endpoints are not reliable drop-in replacements for this template. Vexa sends provider-specific fields in some paths and expects a Vexa-style response with timestamped segments.\n\nThe dashboard and API gateway URLs are inferred from the app name and CapRover root domain during deployment.","end":"Vexa Lite and Vexa Dashboard have been deployed.\n\nDashboard: https://$$cap_appname.$$cap_root_domain\nAPI gateway: https://$$cap_appname-api.$$cap_root_domain\nAPI docs: https://$$cap_appname-api.$$cap_root_domain/docs\n\nUse the Vexa Admin API Token you entered during setup to access dashboard admin features and create users/tokens.\nIf browser bots fail under load, verify the $$cap_appname-api app has enough CPU/RAM for Playwright and that its /dev/shm volume is mounted."},"displayName":"Vexa Lite + Dashboard","isOfficial":true,"description":"Vexa Lite backend with Vexa Dashboard, internal Postgres, persistent recordings, and WebSocket support.","documentation":"Vexa Lite docs: https://github.com/Vexa-ai/vexa/blob/main/docs/vexa-lite-deployment.mdx\nSelf-hosted transcription service: https://github.com/Vexa-ai/vexa/tree/main/services/transcription-service\nDashboard docs: https://github.com/Vexa-ai/Vexa-Dashboard\nDeployment configs: https://github.com/Vexa-ai/vexa-lite-deploy"}}
